<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Md. Masum Iqbal — Academic Portfolio</title>
<style>
  :root{
    --paper:#F0F6FC;
    --ink:#0E3A66;
    --ink-soft:#3E6E9E;
    --blue:#1668C1;
    --blue-light:#4FA3E0;
    --rule:#BFDBF5;
    --panel:#E1EFFB;
    --band1:#0A2C52;
    --band2:#1668C1;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
    line-height:1.65;
    font-size:16px;
  }
  h1,h2,h3{
    font-family:Georgia,"Times New Roman",serif;
    color:var(--ink);
    margin:0 0 0.4em 0;
    font-weight:normal;
  }
  a{ color:var(--blue); }
  a:hover{ color:var(--blue-light); }

  .wrap{ max-width:820px; margin:0 auto; padding:0 24px; }

  /* Nav */
  nav{
    position:sticky; top:0; z-index:10;
    background:rgba(246,248,251,0.95);
    border-bottom:1px solid var(--rule);
    backdrop-filter:blur(4px);
  }
  nav .wrap{
    display:flex; flex-wrap:wrap; gap:4px 20px;
    padding-top:14px; padding-bottom:14px;
    align-items:center; justify-content:space-between;
  }
  nav .brand{ font-family:Georgia,serif; font-size:17px; color:var(--ink); }
  nav .links{ display:flex; flex-wrap:wrap; gap:18px; }
  nav .links a{
    text-decoration:none; color:var(--ink-soft);
    font-size:14px; border-bottom:1px solid transparent;
    padding-bottom:2px; white-space:nowrap;
  }
  nav .links a .num{ color:var(--blue); font-size:12px; margin-right:3px; }
  nav .links a:hover{ color:var(--blue); border-bottom-color:var(--blue); }

  /* Cover band + hero */
  .cover{
    height:150px;
    background:linear-gradient(120deg,var(--band1),var(--band2));
  }
  header.hero{ padding:0 0 40px 0; }
  .hero-row{
    display:flex; gap:28px; align-items:flex-end; flex-wrap:wrap;
    margin-top:-58px;
  }
  .hero-photo{
    width:116px; height:116px; border-radius:50%;
    object-fit:cover; object-position:50% 20%; border:4px solid var(--paper);
    flex-shrink:0; background:var(--panel);
  }
  .hero-text{ flex:1; min-width:240px; padding-bottom:4px; }
  .hero-text h1{ font-size:32px; line-height:1.15; }
  .hero-role{ color:var(--blue); font-size:16px; margin-top:6px; }
  .hero-sub{ color:var(--ink-soft); font-size:14.5px; margin-top:2px; }

  /* Stats row */
  .stats{
    display:flex; flex-wrap:wrap; gap:0;
    margin-top:32px; border:1px solid var(--rule); background:#FAFCFF;
  }
  .stat{
    flex:1; min-width:120px; text-align:center;
    padding:20px 10px; border-right:1px solid var(--rule);
  }
  .stat:last-child{ border-right:none; }
  .stat .num{ font-family:Georgia,serif; font-size:26px; color:var(--blue); }
  .stat .label{ font-size:12.5px; color:var(--ink-soft); margin-top:4px; }

  /* Sections */
  section{ padding:44px 0; border-top:1px solid var(--rule); }
  section h2{ font-size:24px; margin-bottom:20px; }
  section .eyebrow{ color:var(--blue); font-size:13px; margin-bottom:4px; }

  p{ margin:0 0 14px 0; color:var(--ink); }

  .meta-line{ color:var(--ink-soft); font-size:14.5px; margin:2px 0; }
  .meta-line b{ color:var(--ink); font-weight:600; }

  .block{ margin-bottom:26px; }
  .block:last-child{ margin-bottom:0; }
  .block-title{ font-family:Georgia,serif; font-size:18px; margin-bottom:6px; }

  /* Research icon cards */
  .card-grid{
    display:grid; grid-template-columns:repeat(2,1fr); gap:16px;
  }
  .icard{
    background:#FAFCFF; border:1px solid var(--rule);
    padding:18px 18px 20px 18px;
  }
  .icard .icon{ font-size:22px; margin-bottom:8px; display:block; }
  .icard h3{ font-size:16px; margin-bottom:6px; }
  .icard p{ font-size:14.5px; color:var(--ink-soft); margin:0; }

  /* Leadership timeline */
  .tl-item{
    border-left:2px solid var(--blue); padding-left:18px; margin-bottom:22px;
    position:relative;
  }
  .tl-item::before{
    content:""; position:absolute; left:-6px; top:4px;
    width:10px; height:10px; border-radius:50%; background:var(--blue);
  }

  ul.plain{ margin:0; padding-left:20px; }
  ul.plain li{ margin-bottom:8px; color:var(--ink); }

  .tag{
    display:inline-block; font-size:13px; color:var(--blue);
    border:1px solid var(--blue-light); border-radius:3px;
    background:var(--panel);
    padding:2px 8px; margin:0 8px 8px 0;
  }
  .skill-group{ margin-bottom:18px; }
  .skill-group .block-title{ font-size:15.5px; color:var(--ink-soft); margin-bottom:8px; font-family:-apple-system,sans-serif; }

  .pub{
    background:#FAFCFF; border:1px solid var(--rule);
    border-left:3px solid var(--blue);
    padding:16px 18px; font-size:15px; margin-bottom:14px;
  }
  .pub .pub-idx{ color:var(--blue); font-size:13px; margin-bottom:6px; }

  .contact-list{ list-style:none; padding:0; margin:0; }
  .contact-list li{
    display:flex; justify-content:space-between; align-items:baseline;
    padding:10px 0; border-bottom:1px solid var(--rule); font-size:15px;
  }
  .contact-list li:last-child{ border-bottom:none; }
  .contact-list span.label{ color:var(--ink-soft); font-size:13.5px; }

  footer{
    text-align:center; color:var(--ink-soft); font-size:13px;
    padding:30px 0 40px 0;
  }
  footer a{ color:var(--ink-soft); }

  @media (max-width:600px){
    .card-grid{ grid-template-columns:1fr; }
    .hero-row{ flex-direction:column; align-items:flex-start; margin-top:-40px; }
    nav .links{ gap:10px 14px; }
    .contact-list li{ flex-direction:column; align-items:flex-start; gap:2px; }
    .stat{ min-width:45%; }
  }

  /* ===== Box-style layout: every element is a card ===== */
  body{ background:linear-gradient(180deg,#E6F1FC 0%,#F0F6FC 40%); }
  nav{ background:rgba(240,246,252,0.96); }
  nav .links a{
    background:#FAFCFF; border:1px solid var(--rule); border-radius:8px;
    padding:6px 12px; box-shadow:0 1px 3px rgba(22,104,193,0.08);
  }
  nav .links a:hover{ background:var(--blue); color:#fff; border-color:var(--blue); }
  nav .links a:hover .num{ color:#fff; }

  .hero-row{
    background:#FAFCFF; border:1px solid var(--rule); border-radius:14px;
    padding:20px 24px; align-items:center;
    box-shadow:0 6px 18px rgba(22,104,193,0.12);
  }
  .hero-photo{ border-color:#FAFCFF; box-shadow:0 0 0 2px var(--blue-light); }

  .stats{ gap:14px; border:none; background:transparent; }
  .stat{
    background:#FAFCFF; border:1px solid var(--rule); border-radius:12px;
    box-shadow:0 3px 10px rgba(22,104,193,0.08);
  }
  .stat:last-child{ border-right:1px solid var(--rule); }

  section{ padding:14px 0; border-top:none; }
  .box{
    background:#FAFCFF; border:1px solid var(--rule); border-radius:14px;
    padding:28px; box-shadow:0 6px 18px rgba(22,104,193,0.10);
    border-top:4px solid var(--blue);
  }

  .block{
    background:var(--panel); border:1px solid var(--rule); border-radius:10px;
    padding:16px 18px; margin-bottom:16px;
  }
  .block:last-child{ margin-bottom:0; }

  .icard{ border-radius:12px; box-shadow:0 3px 10px rgba(22,104,193,0.08); background:#fff; }
  .icard:hover{ border-color:var(--blue-light); }

  .tl-item{
    background:var(--panel); border:1px solid var(--rule); border-left:4px solid var(--blue);
    border-radius:10px; padding:16px 18px;
  }
  .tl-item::before{ display:none; }

  .skill-group{
    background:var(--panel); border:1px solid var(--rule); border-radius:10px;
    padding:16px 18px 8px 18px; margin-bottom:14px;
  }
  .skill-group:last-child{ margin-bottom:0; }
  .tag{ border-radius:6px; background:#fff; }

  .pub{ border-radius:10px; background:var(--panel); }

  .contact-list li{
    background:var(--panel); border:1px solid var(--rule); border-radius:10px;
    padding:12px 16px; margin-bottom:10px;
  }
  .contact-list li:last-child{ border-bottom:1px solid var(--rule); margin-bottom:0; }

  footer{ padding-top:16px; }
  @media (max-width:600px){
    .box{ padding:20px 16px; }
    .hero-row{ padding:18px 16px; }
  }
</style>
</head>
